{$GUIDEMATE_DOMAIN} {
	# world-client (the Three.js / R3F 3D floor plan) on /viz/*, on the same TLS domain as the
	# chat app. /viz (no trailing slash) is NOT matched by the /viz/* path matcher below, so
	# redirect it rather than let it fall through to the chat app at the root -- that fallthrough
	# would serve the chat app's HTML under a /viz URL, which looks like a routing bug at exactly
	# the moment someone types the short form. `redir` runs before `handle` in Caddy's directive
	# order, so this wins without a `route` block.
	redir /viz /viz/
	# handle_path strips /viz before proxying, so the container's own static server (see
	# world-client/Caddyfile) serves straight from its root: a browser request for
	# /viz/assets/index-xxxx.js arrives here, is rewritten to /assets/index-xxxx.js, and resolves
	# against dist/. The browser asks for the /viz/-prefixed URL because the client is BUILT with
	# base=/viz/ (world-client/Dockerfile's VITE_BASE_PATH build arg, wired in
	# agent_service/compose.yaml). The strip and the base are two halves of one decision: change
	# either alone and every asset 404s.
	handle_path /viz/* {
		reverse_proxy world-client:8080
	}
	# Task 5.1: world-server (Colyseus) routed under /world/* on the same TLS domain,
	# instead of a bare exposed port. handle_path strips the /world prefix before
	# proxying, so the Colyseus client's own root-relative paths (/matchmake/..., and
	# the room WS endpoint /{processId}/{roomId}) still resolve correctly against
	# world-server:2567 -- point the world-client's VITE_WORLD_SERVER_URL at
	# wss://{$GUIDEMATE_DOMAIN}/world (see world-client/src/net/useWorldRoom.ts).
	# reverse_proxy upgrades WebSocket connections automatically; no extra config needed.
	handle_path /world/* {
		reverse_proxy world-server:2567
	}
	# The chat shell assets are versionless (index at /, plus /chat.css and /chat.js), and
	# FastAPI serves them with an ETag but no Cache-Control, so a browser can hold a stale copy
	# heuristically and miss a deploy (this is exactly how a mobile CSS fix failed to reach a
	# phone). Force revalidation on just these paths: no-cache means the browser must check with
	# the server before reuse, and the ETag makes that a cheap 304 when nothing changed. Scoped
	# to these exact paths so the hash-versioned /viz/* bundle assets stay long-cached.
	@chat_shell path / /index.html /chat.css /chat.js
	header @chat_shell Cache-Control "no-cache"
	reverse_proxy app:8000
}
