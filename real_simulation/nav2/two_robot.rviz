Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Marker Scale: 0.6
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /robot_1/map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
    - Class: rviz_default_plugins/LaserScan
      Name: robot_1 scan
      Enabled: true
      Topic:
        Value: /robot_1/scan
        Reliability Policy: Best Effort
      Color: 0; 170; 255
      Size (m): 0.04
      Style: Points
    - Class: rviz_default_plugins/LaserScan
      Name: robot_2 scan
      Enabled: true
      Topic:
        Value: /robot_2/scan
        Reliability Policy: Best Effort
      Color: 255; 120; 0
      Size (m): 0.04
      Style: Points
    - Class: rviz_default_plugins/Path
      Name: robot_1 plan
      Enabled: true
      Topic:
        Value: /robot_1/plan
        Reliability Policy: Reliable
      Color: 0; 170; 255
    - Class: rviz_default_plugins/Path
      Name: robot_2 plan
      Enabled: true
      Topic:
        Value: /robot_2/plan
        Reliability Policy: Reliable
      Color: 255; 120; 0
    - Class: rviz_default_plugins/Polygon
      Name: robot_1 footprint
      Enabled: true
      Topic:
        Value: /robot_1/local_costmap/published_footprint
        Reliability Policy: Reliable
      Color: 0; 170; 255
    - Class: rviz_default_plugins/Polygon
      Name: robot_2 footprint
      Enabled: true
      Topic:
        Value: /robot_2/local_costmap/published_footprint
        Reliability Policy: Reliable
      Color: 255; 120; 0
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 40
      X: 0
      Y: 0
