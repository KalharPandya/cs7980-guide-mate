# Copy to .env and fill in. NEVER commit the real .env (repo rule: no credentials).
#
# Auth for Live Bedrock mode — two options (Simulated mode needs neither):
#
# Option A (local dev): short-lived Bedrock API key / bearer token.
# Regenerate same-day; expires quickly.
AWS_BEARER_TOKEN_BEDROCK=

# Option B (hosted / SigV4): leave the token empty and set BEDROCK_AUTH=sigv4.
# Credentials come from the default AWS chain (SSO profile, instance role, ...).
#BEDROCK_AUTH=sigv4

# Bedrock region. us-west-2 is verified for this model; us-east-1 returned 403.
BEDROCK_REGION=us-west-2

# Model ID (course-fixed).
#BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
