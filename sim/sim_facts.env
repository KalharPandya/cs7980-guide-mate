# sim_facts.env — VERIFIED facts from the TurtleBot 4 Ignition (Gazebo Fortress) sim
# Probed on this box (ROS 2 Humble + Ignition Fortress + turtlebot4_ignition_bringup).
# Date: 2026-07-05. Launch: turtlebot4_ignition.launch.py (slam/nav2/localization/rviz OFF).
# World: warehouse. Model: standard. Robot starts DOCKED.
#
# CRITICAL: everything is UN-namespaced. The launch default namespace is '' (empty),
# so topics/actions are at the root (e.g. /cmd_vel, /odom), NOT /turtlebot4/... .
# This DIFFERS from the real robot 468, which namespaces everything under /turtlebot468.

# --- Namespace ---
SIM_NAMESPACE=
SIM_NAMESPACE_PREFIX=

# --- Motion / velocity ---
SIM_CMD_VEL_TOPIC=/cmd_vel
SIM_CMD_VEL_TYPE=geometry_msgs/msg/Twist

# --- Odometry ---
SIM_ODOM_TOPIC=/odom
SIM_ODOM_TYPE=nav_msgs/msg/Odometry
SIM_ODOM_RATE_HZ=40

# --- Dock status ---
SIM_DOCK_STATUS_TOPIC=/dock_status
SIM_DOCK_STATUS_TYPE=irobot_create_msgs/msg/DockStatus
SIM_DOCK_STATUS_IS_DOCKED_FIELD=is_docked
SIM_DOCK_STATUS_DOCK_VISIBLE_FIELD=dock_visible
SIM_DOCK_STATUS_IS_DOCKED_AT_START=true

# --- Battery ---
SIM_BATTERY_TOPIC=/battery_state
SIM_BATTERY_TYPE=sensor_msgs/msg/BatteryState

# --- Dock / Undock actions (verified: brief's expected names+types match) ---
SIM_UNDOCK_ACTION=/undock
SIM_UNDOCK_ACTION_TYPE=irobot_create_msgs/action/Undock
SIM_DOCK_ACTION=/dock
SIM_DOCK_ACTION_TYPE=irobot_create_msgs/action/Dock

# --- Other sensors / topics of interest ---
SIM_SCAN_TOPIC=/scan
SIM_SCAN_TYPE=sensor_msgs/msg/LaserScan
SIM_HAZARD_TOPIC=/hazard_detection
SIM_HAZARD_TYPE=irobot_create_msgs/msg/HazardDetectionVector
SIM_IR_INTENSITY_TOPIC=/ir_intensity
SIM_KIDNAP_TOPIC=/kidnap_status
SIM_WHEEL_STATUS_TOPIC=/wheel_status
SIM_TF_TOPIC=/tf
SIM_CLOCK_TOPIC=/clock
SIM_USE_SIM_TIME=true

# --- Additional create-3 style actions available in sim ---
SIM_ACTIONS_ALL=/audio_note_sequence,/dock,/drive_arc,/drive_distance,/led_animation,/navigate_to_position,/rotate_angle,/undock,/wall_follow

# --- Bring-up ---
SIM_LAUNCH_PKG=turtlebot4_ignition_bringup
SIM_LAUNCH_FILE=turtlebot4_ignition.launch.py
SIM_LAUNCH_ARGS="slam:=false nav2:=false localization:=false rviz:=false model:=standard"
SIM_WORLD=warehouse
SIM_BRINGUP_SECONDS_MODELS_CACHED=40
SIM_BRINGUP_SECONDS_FIRST_RUN=120-240

# --- Discovery gotcha (see README) ---
# Login profile sets ROS_DISCOVERY_SERVER=10.247.204.21:11811 (the Pi's server).
# It MUST be unset for the sim + any probe on this box, else DDS discovery fails silently.
SIM_REQUIRES_UNSET_DISCOVERY_SERVER=true
